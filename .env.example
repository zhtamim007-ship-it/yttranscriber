# Required: Groq provides Whisper Large v3 and the refinement model.
GROQ_API_KEY=gsk_your_key_here

# Optional OpenAI-compatible overrides
TRANSCRIPTION_BASE_URL=https://api.groq.com/openai/v1
TRANSCRIPTION_MODEL=whisper-large-v3
REFINEMENT_BASE_URL=https://api.groq.com/openai/v1
REFINEMENT_MODEL=llama-3.3-70b-versatile
# TRANSCRIPTION_API_KEY=...
# REFINEMENT_API_KEY=...

# Resilience against transient provider failures (HTTP 500/502/503/504):
# - TRANSCRIPTION_MAX_ATTEMPTS: upload retries per (model, encoding) pair
#   before falling back (primary pair gets the full budget, fallbacks get 2).
# - TRANSCRIPTION_RETRY_AFTER_CAP_SECONDS: max backoff sleep per attempt.
# - TRANSCRIPTION_MODEL_FALLBACKS: extra models tried ONLY when the configured
#   model keeps returning transient server errors (never on auth failures).
#   Set to an empty value to disable model fallback.
TRANSCRIPTION_MAX_ATTEMPTS=5
TRANSCRIPTION_RETRY_AFTER_CAP_SECONDS=45
TRANSCRIPTION_MODEL_FALLBACKS=whisper-large-v3-turbo

# Runtime controls
MAX_VIDEO_DURATION_SECONDS=21600
MAX_CONCURRENT_JOBS=2
JOB_TTL_SECONDS=14400
ENABLE_DENOISE=true
# YTDLP_COOKIES_FILE=/run/secrets/youtube-cookies.txt
